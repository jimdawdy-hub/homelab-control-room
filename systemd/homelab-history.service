[Unit]
Description=Homelab Control Room history
After=network-online.target
Wants=homelab-collect.service
After=homelab-collect.service
[Service]
Type=oneshot
User=homelab-monitor
Group=homelab-monitor
WorkingDirectory=/opt/homelab-control-room
ExecStart=/opt/homelab-control-room/.venv/bin/python -B /opt/homelab-control-room/telemetry/history.py --data-dir data
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/homelab-control-room/data
UMask=0077
TimeoutStartSec=90
Nice=10
